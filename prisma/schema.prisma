generator client {
  provider = "prisma-client"
  output   = "./generated"
  engineType = "node"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id          Int          @id @default(autoincrement())
  slug        String       @unique @default(cuid())
  name        String
  description String?
  tags        String[]
  cuisine     String?
  category    String?
  servings    Int?
  prepTime    Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  notes       String?
  createdById String
  ingredients Ingredient[]
  createdBy   User         @relation(fields: [createdById], references: [clerkId])
  steps       Step[]
  uploads     Upload[]

  @@index([name])
}

model Step {
  id       Int    @id @default(autoincrement())
  order    Int
  content  String
  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id])
}

model Ingredient {
  id       Int     @id @default(autoincrement())
  name     String
  amount   Float?
  unit     String?
  section  String?
  recipeId Int
  recipe   Recipe  @relation(fields: [recipeId], references: [id])
}

model Upload {
  id           String   @id @default(cuid())
  url          String
  fileName     String   @unique
  fileType     String
  fileSize     Int
  createdAt    DateTime @default(now())
  recipeId     Int?
  uploadedById String
  recipe       Recipe?  @relation(fields: [recipeId], references: [id])
  uploadedBy   User     @relation(fields: [uploadedById], references: [clerkId])
}

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  clerkId         String    @unique
  banned          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  firstName       String?
  imageUrl        String?
  lastActivedAt   DateTime?
  lastName        String?
  lastSignInAt    DateTime?
  legalAcceptedAt DateTime?
  phoneNumber     String?   @unique
  updatedAt       DateTime  @updatedAt
  username        String?   @unique
  recipes         Recipe[]
  uploads         Upload[]
}
